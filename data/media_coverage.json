   "media_coverage_title": {
    "ja": "生成ＡＩパイロット校 札幌中央小 AIとの対話力育成へ プロンプト設計能力重点に"
   },
   "writer_myself": "other_than_myself",
   "event": {
    "ja": "北海道通信日刊教育版"
   },
   "publication_date": "2025-08-08",
   "location": {
    "ja": "p8"
   },
   "media_coverage_type": "paper",
   "description": {
    "ja": "中里彰吾教諭は「プロンプトを工夫することで、AIから引き出せる情報が大きく変わることを児童たちは体験的に学んでいる。“どうすればもっと良い答えが返ってくるか”と楽しそうに試行錯誤している。AIをただの道具として使うのではなく、自分の思考を深めるためのパートナーとして活用する力を育んでいきたい」と話している。"
   },
   "see_also": [
    {
     "@id": "https://education.dotsu.co.jp/articles/detail/112202",
     "label": "url"
    }
   ]
  },
  {
   "@id": "https://api.researchmap.jp/naka_sato/media_coverage/50622996",
   "@type": "media_coverage",
   "@reverse": "https://api.researchmap.jp/naka_sato/media_coverage",
   "rm:id": "50622996",
   "rm:user_id": "R000079949",
   "display": "disclosed",
   "major_achievement": false,
   "rm:creator_id": "R000079949",
   "rm:creator_type": "myself",
